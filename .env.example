# Copy this to .env at the repo root before running `docker compose up`.
# Never commit the real .env.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Postgres password used by both the db and app services.
POSTGRES_PASSWORD=change-this-too

# Public URL you'll actually deploy to, e.g. https://app.cyberverse.ai
APP_BASE_URL=http://localhost:8000

# Only needed if you split the frontend onto a different origin/CDN.
ALLOWED_ORIGINS=

# Leave blank to just log password-reset emails to container logs (not fine
# for real production - set these to a real SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cyberverse.ai
