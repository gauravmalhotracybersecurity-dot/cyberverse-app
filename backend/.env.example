# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Random long string used to sign JWTs. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30

# SQLite for local dev. In production use Postgres, e.g.:
#   postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./cyberverse.db

# Only matters if the frontend is served from a different origin than this
# API (split deployment). Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Set to "" to disable FastAPI serving the frontend itself.
FRONTEND_DIR=../frontend

# Leave SMTP_HOST blank to just log password-reset emails to the console
# (fine for local dev). Set these for real email delivery in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cyberverse.ai
SMTP_USE_TLS=true

# Used to build links inside emails (e.g. the password reset link).
APP_BASE_URL=http://127.0.0.1:8080

# Rate limits for cost-bearing AI endpoints and auth endpoints.
RATE_LIMIT_CHAT=30/hour
RATE_LIMIT_DAILY=10/hour
RATE_LIMIT_RESUME=10/hour
RATE_LIMIT_INTERVIEW=20/hour
RATE_LIMIT_AUTH=10/minute
